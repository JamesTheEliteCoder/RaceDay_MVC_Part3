@model List<RaceDay_MVC_Part3.Models.ParticipantEnrolmentViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container py-5">

    @* Participant page heading. *@
    <div class="dashboard-hero mb-5 p-4 p-md-5">
        <span class="dashboard-eyebrow">
            PARTICIPANT PORTAL
        </span>

        <h1 class="display-5 fw-bold mt-3 mb-2">
            My Events
        </h1>

        <p class="lead mb-0">
            Your race journey, all in one place.
            Track your entries, check your enrolment details
            and prepare for your next challenge.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        @* Display a helpful message when the participant has no enrolments. *@
        <div class="card event-dashboard-card">
            <div class="card-body text-center py-5">

                <div class="display-4 mb-3">🏁</div>

                <h2 class="h4 fw-bold mb-3">
                    No events yet!
                </h2>

                <p class="text-muted mb-4">
                    You haven't enrolled in any events.
                    Explore available races and find your next challenge.
                </p>

                <a asp-controller="Participant"
                   asp-action="BrowseEvents"
                   class="btn btn-raceday">
                    Browse Events
                </a>

            </div>
        </div>
    }
    else
    {
        @* Display each participant enrolment as an event card. *@
        <div class="row g-4">

            @foreach (var enrolment in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <article class="card event-dashboard-card h-100">

                        <div class="event-card-accent"></div>

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="event-type-badge">
                                    MY ENTRY
                                </span>

                                @if (enrolment.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        @enrolment.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @enrolment.Status
                                    </span>
                                }
                            </div>

                            <h2 class="h4 card-title fw-bold mb-2">
                                @enrolment.EventName
                            </h2>

                            <p class="text-muted mb-4">
                                @enrolment.Venue, @enrolment.City
                            </p>

                            <div class="event-details">

                                <div class="event-detail-row">
                                    <span class="event-detail-icon">📅</span>

                                    <div>
                                        <small>EVENT DATE</small>

                                        <strong>
                                            @enrolment.EventDate.ToString("dd MMMM yyyy")
                                        </strong>
                                    </div>
                                </div>

                                <div class="event-detail-row">
                                    <span class="event-detail-icon">🏃</span>

                                    <div>
                                        <small>CATEGORY</small>

                                        <strong>
                                            @enrolment.CategoryName
                                        </strong>
                                    </div>
                                </div>

                                <div class="event-detail-row">
                                    <span class="event-detail-icon">📝</span>

                                    <div>
                                        <small>ENROLLED ON</small>

                                        <strong>
                                            @enrolment.EnrolmentDate.ToString("dd MMMM yyyy")
                                        </strong>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="event-card-actions p-3">

                            <a asp-controller="Participant"
                               asp-action="EventDetails"
                               asp-route-id="@enrolment.EventId"
                               class="btn btn-raceday-outline w-100">
                                View Event Details
                            </a>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

</div>
