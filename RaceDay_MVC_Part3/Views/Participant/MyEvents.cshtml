@model List<RaceDay_MVC_Part3.Models.ParticipantEnrolmentViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">My Events</h2>
        <p class="text-muted">
            Keep track of the races you've entered and your enrolment details.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <h5 class="alert-heading">No events yet!</h5>
            <p class="mb-3">
                You haven't enrolled in any events. Explore available races
                and find your next challenge.
            </p>

            <a asp-controller="Participant"
               asp-action="BrowseEvents"
               class="btn btn-primary">
                Browse Events
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var enrolment in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @enrolment.EventName
                            </h5>

                            <p class="text-muted mb-3">
                                @enrolment.Venue, @enrolment.City
                            </p>

                            <hr />

                            <p>
                                <strong>Event Date:</strong>
                                @enrolment.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Category:</strong>
                                @enrolment.CategoryName
                            </p>

                            <p>
                                <strong>Enrolled On:</strong>
                                @enrolment.EnrolmentDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (enrolment.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        @enrolment.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @enrolment.Status
                                    </span>
                                }
                            </p>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <a asp-controller="Participant"
                               asp-action="EventDetails"
                               asp-route-id="@enrolment.EventId"
                               class="btn btn-outline-primary w-100">
                                View Event Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>