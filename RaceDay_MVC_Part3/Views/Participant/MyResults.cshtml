
@model List<RaceDay_MVC_Part3.Models.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container py-5">

    @* Results page heading. *@
    <div class="dashboard-hero mb-5 p-4 p-md-5">

        <span class="dashboard-eyebrow">
            PARTICIPANT PORTAL
        </span>

        <h1 class="display-5 fw-bold mt-3 mb-2">
            My Race Results
        </h1>

        <p class="lead mb-0">
            Every race tells a story.
            Track your performances, celebrate your achievements
            and see how you placed against the competition.
        </p>

    </div>

    @if (Model == null || !Model.Any())
    {
        @* Empty state when no results have been recorded. *@
        <div class="card event-dashboard-card">
            <div class="card-body text-center py-5">

                <div class="display-4 mb-3">🏆</div>

                <h2 class="h4 fw-bold mb-3">
                    No Results Yet
                </h2>

                <p class="text-muted mb-4">
                    Your race results will appear here once an organiser
                    has recorded your finishing position and time.
                </p>

                <a asp-controller="Participant"
                   asp-action="BrowseEvents"
                   class="btn btn-raceday">
                    Browse Upcoming Events
                </a>

            </div>
        </div>
    }
    else
    {
        @* Display each recorded race result. *@
        <div class="row g-4">

            @foreach (var result in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <article class="card event-dashboard-card h-100">

                        <div class="event-card-accent"></div>

                        <div class="card-body p-4">

                            @* Event information. *@
                            <div class="mb-4">

                                <span class="event-type-badge">
                                    RACE RESULT
                                </span>

                                <h2 class="h4 card-title fw-bold mt-3 mb-2">
                                    @result.EventName
                                </h2>

                                <p class="text-muted mb-0">
                                    <span class="me-2">📅</span>
                                    @result.EventDate.ToString("dd MMMM yyyy")
                                </p>

                            </div>

                            <div class="divider"
                                 style="border-top: 1px solid var(--raceday-border);">
                            </div>

                            @* Finishing position highlight. *@
                            <div class="result-highlight text-center my-4 p-4">

                                <small class="result-label">
                                    FINISHING POSITION
                                </small>

                                <div class="result-position">
                                    @GetOrdinal(result.FinishingPosition)
                                </div>

                                <p class="text-muted small mb-0">
                                    Out of @result.TotalCategoryResults recorded results
                                </p>

                            </div>

                            @* Category and finishing time. *@
                            <div class="event-details">

                                <div class="event-detail-row">

                                    <span class="event-detail-icon">🏃</span>

                                    <div>
                                        <small>RACE CATEGORY</small>

                                        <strong>
                                            @result.CategoryName
                                        </strong>
                                    </div>

                                </div>

                                <div class="event-detail-row">

                                    <span class="event-detail-icon">⏱️</span>

                                    <div>
                                        <small>FINISHING TIME</small>

                                        <strong class="result-time">
                                            @result.FinishTime.ToString("hh\\:mm\\:ss")
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

    @* Return to the participant dashboard. *@
    <div class="mt-5">

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-raceday-outline">
            &larr; Back to Dashboard
        </a>

    </div>

</div>

@functions {
    // Converts a finishing position into its ordinal representation.
    // Examples: 1 becomes 1st, 2 becomes 2nd, 3 becomes 3rd, 4 becomes 4th.
    public static string GetOrdinal(int position)
    {
        // Positions ending in 11, 12 or 13 always use "th".
        if (position % 100 >= 11 && position % 100 <= 13)
        {
            return position + "th";
        }

        // Determine the correct suffix from the final digit.
        return (position % 10) switch
        {
            1 => position + "st",
            2 => position + "nd",
            3 => position + "rd",
            _ => position + "th"
        };
    }
}
