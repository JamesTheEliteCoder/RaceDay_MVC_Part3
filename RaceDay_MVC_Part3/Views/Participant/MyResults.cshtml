@model List<RaceDay_MVC_Part3.Models.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">My Race Results</h2>
        <p class="text-muted">
            Track your race performances and see how you placed in each event.
        </p>
    </div>

</div>

@if (Model == null || !Model.Any())
{
    <!-- Display a friendly message when the participant has no recorded results. -->
    <div class="card shadow-sm border-0 p-4 text-center">
        <div class="card-body">
            <h4 class="fw-bold">No Results Yet</h4>

            <p class="text-muted">
                Your race results will appear here once an organiser
                has recorded your finishing position and time.
            </p>

            <a asp-controller="Participant"
               asp-action="BrowseEvents"
               class="btn btn-primary mt-2">
                Browse Upcoming Events
            </a>
        </div>
    </div>
}
else
{
    <!-- Display each recorded race result in its own card. -->
    <div class="row g-4">
        @foreach (var result in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">

                        <h5 class="card-title fw-bold">
                            @result.EventName
                        </h5>

                        <p class="text-muted mb-3">
                            @result.EventDate.ToString("dd MMMM yyyy")
                        </p>

                        <hr />

                        <p>
                            <strong>Category:</strong>
                            @result.CategoryName
                        </p>

                        <p>
                            <strong>Finishing Position:</strong>
                            @GetOrdinal(result.FinishingPosition)
                            out of @result.TotalCategoryResults recorded results
                        </p>

                        <p>
                            <strong>Finishing Time:</strong>
                            @result.FinishTime.ToString("hh\\:mm\\:ss")
                        </p>

                    </div>
                </div>
            </div>
        }
    </div>
}

@functions {
    // Converts a finishing position into its ordinal representation.
    // Examples: 1 becomes 1st, 2 becomes 2nd, 3 becomes 3rd, 4 becomes 4th.
    public static string GetOrdinal(int position)
    {
        // Positions ending in 11, 12 or 13 always use "th".
        if (position % 100 >= 11 && position % 100 <= 13)
        {
            return position + "th";
        }

        // Determine the correct suffix from the final digit.
        return (position % 10) switch
        {
            1 => position + "st",
            2 => position + "nd",
            3 => position + "rd",
            _ => position + "th"
        };
    }
}