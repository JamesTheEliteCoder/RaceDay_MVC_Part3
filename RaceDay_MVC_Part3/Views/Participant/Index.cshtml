@{
    // Set the page title for the shared MVC layout.
    ViewData["Title"] = "Participant Home";
}

<div class="container py-5">
    <div class="mb-4">
        <span class="badge text-bg-success mb-2">PARTICIPANT PORTAL</span>

        <h1 class="display-5 fw-bold">Your RaceDay Journey</h1>

        <p class="lead text-muted">
            Discover your next challenge, track your race entries,
            and celebrate your results.
        </p>
    </div>

    @* Personalise the page using the first name stored after login. *@
    <div class="alert alert-success" role="status">
        Welcome, @(Context.Session.GetString("FirstName") ?? "Participant")!
        Ready for your next race?
    </div>

    <div class="row g-4">

        @* Discover Events card *@
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">Discover Events</h2>

                    <p class="card-text">
                        Explore upcoming runs, walks and cycling events.
                    </p>

                    @* Take participants to the event discovery page. *@
                    <a asp-controller="Participant"
                       asp-action="BrowseEvents"
                       class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        @* My Events card *@
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">My Events</h2>

                    <p class="card-text">
                        Review your race entries and enrolment statuses.
                    </p>

                    @* Allow participants to view their enrolments. *@
                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn btn-outline-success">
                        View My Events
                    </a>
                </div>
            </div>
        </div>

        @* My Results card *@
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">My Results</h2>

                    <p class="card-text">
                        Look back at your finishing times and race positions.
                    </p>

                    @* Navigate to the participant's personal race results. *@
                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="btn btn-outline-success">
                        View My Results
                    </a>
                </div>
            </div>
        </div>

        @* My Profile card *@
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">My Profile</h2>

                    <p class="card-text">
                        View and update your personal information and account details.
                    </p>

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-success">
                        View My Profile
                    </a>
                </div>
            </div>
        </div>