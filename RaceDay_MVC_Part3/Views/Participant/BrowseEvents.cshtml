@model List<RaceDay_MVC_Part3.Models.EventViewModel>

@{
    ViewData["Title"] = "Discover Events";
}

<div class="container py-5">

    <!-- Page heading -->
    <div class="mb-4">
        <span class="badge bg-primary mb-2">Participant Portal</span>
        <h1 class="fw-bold">Discover Events</h1>
        <p class="text-muted">
            Find your next challenge and get ready to race!
        </p>
    </div>

    <!-- Display available events -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <h5>No events available</h5>
                <p class="text-muted mb-0">
                    There are currently no events available to browse.
                    Please check again later.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body d-flex flex-column">

                            <div class="mb-3">
                                <span class="badge bg-primary">
                                    @raceEvent.EventType
                                </span>

                                <span class="badge bg-secondary">
                                    @raceEvent.DistanceKm km
                                </span>
                            </div>

                            <h5 class="card-title fw-bold">
                                @raceEvent.Name
                            </h5>

                            <p class="text-muted small">
                                @raceEvent.Description
                            </p>

                            <div class="mt-auto">

                                <p class="mb-2">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    @raceEvent.EventDate.ToString("dd MMM yyyy")
                                </p>

                                <p class="mb-3">
                                    <i class="bi bi-geo-alt me-2"></i>
                                    @raceEvent.Venue, @raceEvent.City
                                </p>

                                <a asp-controller="Participant"
                                   asp-action="EventDetails"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-primary w-100">
                                    View Event
                                </a>

                            </div>

                        </div>
                    </div>

                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>