
@model List<RaceDay_MVC_Part3.Models.EventViewModel>

@{
    ViewData["Title"] = "Discover Events";
}

<div class="container py-5">

    @* Page heading. *@
    <div class="dashboard-hero mb-5 p-4 p-md-5">

        <span class="dashboard-eyebrow">
            PARTICIPANT PORTAL
        </span>

        <h1 class="display-5 fw-bold mt-3 mb-2">
            Discover Events
        </h1>

        <p class="lead mb-0">
            Find your next challenge, explore upcoming races
            and get ready to cross that finish line.
        </p>

    </div>

    @* Display available events retrieved from the API. *@
    @if (Model == null || !Model.Any())
    {
        <div class="card event-dashboard-card">
            <div class="card-body text-center py-5">

                <div class="display-4 mb-3">🏁</div>

                <h2 class="h4 fw-bold mb-3">
                    No events available
                </h2>

                <p class="text-muted mb-0">
                    There are currently no events available to browse.
                    Please check again later.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <article class="card event-dashboard-card h-100">

                        @* Display the event banner when available. *@
                        @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageUrl))
                        {
                            <img src="@Url.Action("EventBanner", "Images",
                                                  new { eventId = raceEvent.EventId })"
                                 alt="@raceEvent.Name event banner"
                                 class="card-img-top"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center"
                                 style="height: 200px; background-color: var(--raceday-surface-raised);">

                                <span class="text-muted">
                                    <i class="bi bi-image me-2"></i>
                                    No event banner
                                </span>

                            </div>
                        }

                        <div class="event-card-accent"></div>

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex flex-wrap gap-2 mb-3">

                                <span class="event-type-badge">
                                    @raceEvent.EventType
                                </span>

                                <span class="badge bg-secondary">
                                    @raceEvent.DistanceKm.ToString("0.##") km
                                </span>

                            </div>

                            <h2 class="h4 card-title fw-bold mb-2">
                                @raceEvent.Name
                            </h2>

                            <p class="text-muted event-description">
                                @raceEvent.Description
                            </p>

                            <div class="event-details mt-auto pt-3">

                                <div class="event-detail-row">

                                    <span class="event-detail-icon">📅</span>

                                    <div>
                                        <small>EVENT DATE</small>

                                        <strong>
                                            @raceEvent.EventDate.ToString("dd MMMM yyyy")
                                        </strong>
                                    </div>

                                </div>

                                <div class="event-detail-row">

                                    <span class="event-detail-icon">📍</span>

                                    <div>
                                        <small>LOCATION</small>

                                        <strong>
                                            @raceEvent.Venue
                                        </strong>

                                        <span>
                                            @raceEvent.City
                                        </span>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="event-card-actions p-3">

                            <a asp-controller="Participant"
                               asp-action="EventDetails"
                               asp-route-id="@raceEvent.EventId"
                               class="btn btn-raceday w-100">
                                View Event Details
                            </a>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

    @* Return to the participant dashboard. *@
    <div class="mt-5">

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-raceday-outline">
            &larr; Back to Dashboard
        </a>

    </div>

</div>
