
@model RaceDay_MVC_Part3.Models.EventDetailsViewModel

@{
    ViewData["Title"] = Model.Event.Name;
}

<div class="container py-5">

    @* Event banner. *@
    @if (!string.IsNullOrWhiteSpace(Model.Event.BannerImageUrl))
    {
        <div class="mb-4">
            <img src="@Url.Action("EventBanner", "Images",
                new { eventId = Model.Event.EventId })"
                 alt="@Model.Event.Name event banner"
                 class="img-fluid w-100 rounded shadow-sm"
                 style="max-height: 420px; object-fit: cover;" />
        </div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-center rounded mb-4"
             style="height: 220px; background-color: var(--raceday-surface-raised);">

            <span class="text-muted">
                <i class="bi bi-image me-2"></i>
                Event banner unavailable
            </span>

        </div>
    }

    @* Event identity and description. *@
    <div class="dashboard-hero mb-5 p-4 p-md-5">

        <span class="dashboard-eyebrow">
            @Model.Event.EventType
        </span>

        <h1 class="display-5 fw-bold mt-3 mb-3">
            @Model.Event.Name
        </h1>

        <p class="lead mb-0">
            @Model.Event.Description
        </p>

    </div>

    @* Event information. *@
    <section class="mb-5">

        <h2 class="h3 fw-bold mb-4">
            Event Information
        </h2>

        <div class="row g-3">

            <div class="col-12 col-md-6">
                <div class="card event-dashboard-card h-100">
                    <div class="card-body p-4">

                        <div class="event-detail-row">
                            <span class="event-detail-icon">📅</span>

                            <div>
                                <small>EVENT DATE</small>

                                <strong>
                                    @Model.Event.EventDate.ToString("dd MMMM yyyy")
                                </strong>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card event-dashboard-card h-100">
                    <div class="card-body p-4">

                        <div class="event-detail-row">
                            <span class="event-detail-icon">🏃</span>

                            <div>
                                <small>DISTANCE</small>

                                <strong>
                                    @Model.Event.DistanceKm.ToString("0.##") km
                                </strong>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card event-dashboard-card h-100">
                    <div class="card-body p-4">

                        <div class="event-detail-row">
                            <span class="event-detail-icon">📍</span>

                            <div>
                                <small>VENUE</small>

                                <strong>
                                    @Model.Event.Venue
                                </strong>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card event-dashboard-card h-100">
                    <div class="card-body p-4">

                        <div class="event-detail-row">
                            <span class="event-detail-icon">🌍</span>

                            <div>
                                <small>LOCATION</small>

                                <strong>
                                    @Model.Event.City, @Model.Event.Province
                                </strong>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </section>

    @* Available enrolment categories. *@
    <section class="mb-5">

        <h2 class="h3 fw-bold mb-2">
            Available Categories
        </h2>

        <p class="text-muted mb-4">
            Choose the category that suits you and secure your place.
        </p>

        @if (Model.Categories == null || !Model.Categories.Any())
        {
            <div class="card event-dashboard-card">
                <div class="card-body py-4">

                    <p class="text-muted mb-0">
                        No categories are currently available for this event.
                    </p>

                </div>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var category in Model.Categories)
                {
                    <div class="col-12 col-md-6 col-xl-4">

                        <article class="card event-dashboard-card h-100">

                            <div class="event-card-accent"></div>

                            <div class="card-body p-4 d-flex flex-column">

                                <div class="mb-3">
                                    <span class="event-type-badge">
                                        @category.CategoryType
                                    </span>
                                </div>

                                <h3 class="h4 card-title fw-bold mb-3">
                                    @category.Name
                                </h3>

                                <div class="flex-grow-1">

                                    @if (category.CategoryType == "Age")
                                    {
                                        <div class="event-detail-row">

                                            <span class="event-detail-icon">👥</span>

                                            <div>
                                                <small>AGE RANGE</small>

                                                <strong>
                                                    @(category.MinimumAge?.ToString() ?? "No minimum")
                                                    –
                                                    @(category.MaximumAge?.ToString() ?? "No maximum")
                                                </strong>
                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="event-detail-row">

                                            <span class="event-detail-icon">🏁</span>

                                            <div>
                                                <small>RACE DISTANCE</small>

                                                <strong>
                                                    @Model.Event.DistanceKm.ToString("0.##") km event
                                                </strong>
                                            </div>

                                        </div>
                                    }

                                </div>

                                @* Secure category enrolment form. *@
                                <form asp-controller="Participant"
                                      asp-action="Enrol"
                                      method="post"
                                      class="mt-4">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="eventId"
                                           value="@Model.Event.EventId" />

                                    <input type="hidden"
                                           name="categoryId"
                                           value="@category.CategoryId" />

                                    <button type="submit"
                                            class="btn btn-raceday w-100">

                                        <i class="bi bi-check-circle me-1"></i>
                                        Enrol Now

                                    </button>

                                </form>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }

    </section>

    @* Return to event discovery. *@
    <div class="mt-4">

        <a asp-controller="Participant"
           asp-action="BrowseEvents"
           class="btn btn-raceday-outline">

            &larr; Back to Events

        </a>

    </div>

</div>
