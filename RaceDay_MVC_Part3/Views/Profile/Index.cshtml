@model RaceDay_MVC_Part3.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">



    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }


    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="fw-bold">My Profile</h1>
            <p class="text-muted">
                View and manage your personal information.
            </p>
        </div>

        <a asp-controller="Profile"
           asp-action="Edit"
           class="btn btn-primary">
            <i class="bi bi-pencil-square me-1"></i>
            Edit Profile
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="text-center mb-4">
    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
    {
        <img src="@Url.Action("ProfilePicture", "Images")"
             alt="Profile Picture"
             class="rounded-circle shadow-sm"
             style="width: 150px; height: 150px; object-fit: cover;" />
    }
    else
    {
        <div class="rounded-circle bg-light border d-inline-flex
                    align-items-center justify-content-center"
             style="width: 150px; height: 150px;">
            <i class="bi bi-person-fill text-secondary"
               style="font-size: 4rem;"></i>
        </div>
    }
</div>


<form asp-controller="Profile"
      asp-action="UploadProfilePicture"
      method="post"
      enctype="multipart/form-data"
      class="text-center mb-4">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="ProfilePicture" class="form-label fw-semibold">
            Change Profile Picture
        </label>

        <input type="file"
               id="ProfilePicture"
               name="ProfilePicture"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp"
               required />
    </div>

    <button type="submit" class="btn btn-outline-primary">
        <i class="bi bi-cloud-arrow-up me-1"></i>
        Upload Picture
    </button>
</form>
            <div class="mb-4">
                <h4 class="fw-bold">Personal Information</h4>
                <p class="text-muted">
                    Your registered account details.
                </p>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">First Name</label>
                    <p class="form-control-plaintext">
                        @Model.FirstName
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Last Name</label>
                    <p class="form-control-plaintext">
                        @Model.LastName
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email Address</label>
                    <p class="form-control-plaintext">
                        @Model.Email
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Phone Number</label>
                    <p class="form-control-plaintext">
                        @Model.PhoneNumber
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Date of Birth</label>
                    <p class="form-control-plaintext">
                        @Model.DateOfBirth.ToString("dd MMMM yyyy")
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Account Type</label>
                    <p class="form-control-plaintext">
                        @Model.Role
                    </p>
                </div>

            </div>

        </div>
    </div>

</div>