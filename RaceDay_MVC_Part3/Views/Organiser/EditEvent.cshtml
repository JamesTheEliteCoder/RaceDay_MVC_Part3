
@model RaceDay_MVC_Part3.Models.EditEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 mb-2">Edit Event</h1>
                    <p class="text-muted mb-4">
                        Update your event details below.
                    </p>

                    <form asp-action="EditEvent" method="post">
                        @Html.AntiForgeryToken()

                        @* Keep the event ID attached to the submitted form. *@
                        <input asp-for="EventId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" type="date"
                                   class="form-control" />
                            <span asp-validation-for="EventDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Venue" class="form-label"></label>
                            <input asp-for="Venue" class="form-control" />
                            <span asp-validation-for="Venue"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Province" class="form-label"></label>
                                <input asp-for="Province" class="form-control" />
                                <span asp-validation-for="Province"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DistanceKm" class="form-label"></label>
                                <input asp-for="DistanceKm" type="number"
                                       step="0.01" min="0.01"
                                       class="form-control" />
                                <span asp-validation-for="DistanceKm"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EventType" class="form-label"></label>
                                <select asp-for="EventType" class="form-select">
                                    <option value="">Select event type</option>
                                    <option value="Run">Run</option>
                                    <option value="Walk">Walk</option>
                                    <option value="Cycle">Cycle</option>
                                </select>
                                <span asp-validation-for="EventType"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-action="Dashboard"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
