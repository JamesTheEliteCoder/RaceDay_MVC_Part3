
@model List<RaceDay_MVC_Part3.Models.EventViewModel>

@{
    // Set the title displayed by the shared page layout.
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">
    <div class="mb-4">
        <span class="badge text-bg-primary mb-2">ORGANISER PORTAL</span>
        <h1 class="display-5 fw-bold">Your RaceDay Dashboard</h1>
        <p class="lead text-muted">
            Manage your events, categories, participants and race results
            from one place.
        </p>
    </div>

    @* Welcome the organiser using the first name stored at login. *@
    <div class="alert alert-info" role="status">
        Welcome, @(Context.Session.GetString("FirstName") ?? "Organiser")!
        Your organiser workspace is ready.
    </div>

    @* Display the events retrieved from the Part 2 API. *@
    <section class="mb-5" aria-labelledby="myEventsHeading">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h2 id="myEventsHeading" class="h3 fw-bold mb-1">My Events</h2>
                <p class="text-muted mb-0">
                    View the events associated with your organiser account.
                </p>
            </div>

            @* Open the form used to create a new event. *@
            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="btn btn-primary mt-2">
                <span aria-hidden="true">+</span> Create Event
            </a>
        </div>

        @if (Model is null || Model.Count == 0)
        {
            @* Explain the empty state instead of showing a blank section. *@
            <div class="card shadow-sm">
                <div class="card-body py-5 text-center">
                    <h3 class="h5">No events yet</h3>
                    <p class="text-muted mb-0">
                        Events you create will appear here.
                    </p>
                </div>
            </div>
        }
        else
        {
            @* Show each event returned by the API as a Bootstrap card. *@
            <div class="row g-4">
                @foreach (var raceEvent in Model)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <article class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <span class="badge text-bg-primary">
                                        @raceEvent.EventType
                                    </span>

                                    <span class="text-muted small">
                                        @raceEvent.DistanceKm.ToString("0.##") km
                                    </span>
                                </div>

                                <h3 class="h5 card-title fw-bold">
                                    @raceEvent.Name
                                </h3>

                                <p class="card-text text-muted">
                                    @raceEvent.Description
                                </p>

                                <hr />

                                <p class="mb-2">
                                    <strong>Date:</strong>
                                    @raceEvent.EventDate.ToString("dd MMM yyyy")
                                </p>

                                <p class="mb-0">
                                    <strong>Location:</strong><br />
                                    @raceEvent.Venue<br />
                                    @raceEvent.City, @raceEvent.Province
                                </p>
                            </div>

                            <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                                @* Open the edit form for this specific event. *@
                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit Event
                                </a>
                                <a asp-controller="Organiser"
                                   asp-action="ManageEvent"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-outline-success">
                                    Manage Routes & Categories
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    @* Keep the other dashboard areas as placeholders for future milestones. *@
    <div class="row g-4">
        <div class="col-12 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">Categories and Routes</h2>
                    <p class="card-text">
                        Organise race categories and configure event routes.
                    </p>
                    <button type="button"
                            class="btn btn-outline-primary mt-2"
                            disabled>
                        Manage categories — coming soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">Participants and Results</h2>
                    <p class="card-text">
                        Review enrolments and record race finishing results.
                    </p>
                    <button type="button"
                            class="btn btn-outline-primary"
                            disabled>
                        View race entries — coming soon
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
