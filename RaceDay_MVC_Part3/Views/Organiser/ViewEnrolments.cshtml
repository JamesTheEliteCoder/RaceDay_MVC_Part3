@model RaceDay_MVC_Part3.Models.EventEnrolmentsViewModel

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary mb-2">Organiser</span>
            <h1 class="display-6">Event Enrolments</h1>
            <p class="text-muted mb-0">@Model.EventName</p>
        </div>

        <a asp-controller="Organiser"
           asp-action="ManageEvent"
           asp-route-id="@Model.EventId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Event
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h4 mb-0">Registered Participants</h2>

                <span class="badge bg-info text-dark">
                    @Model.Enrolments.Count Participants
                </span>
            </div>

            @if (!Model.Enrolments.Any())
            {
                <div class="alert alert-info mb-0">
                    No participants have enrolled in this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Participant</th>
                                <th>Email Address</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrolment in Model.Enrolments)
                            {
                                <tr>
                                    <td>
                                        <strong>@enrolment.ParticipantName</strong>
                                        <div class="small text-muted">
                                            ID: @enrolment.ParticipantId
                                        </div>
                                    </td>

                                    <td>@enrolment.ParticipantEmail</td>

                                    <td>@enrolment.CategoryName</td>

                                    <td>
                                        @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (enrolment.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">
                                                @enrolment.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @enrolment.Status
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>
