@model RaceDay_MVC_Part3.Models.EventManagementViewModel

@{
    ViewData["Title"] = "Manage Event";
}

<div class="container mt-4">

    <!-- Page heading -->
    <div class="mb-4">
        <h1>Manage Event</h1>
        <h4 class="text-muted">@Model.EventName</h4>
        <p class="text-muted">
            Manage the routes and participant categories for this event.
        </p>
    </div>

    <!-- Routes section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Event Routes</h2>

        <a asp-controller="Organiser"
           asp-action="CreateRoute"
           asp-route-eventId="@Model.EventId"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Route
        </a>
    </div>

        @if (Model.Routes.Count == 0)
        {
            <div class="alert alert-info">
                No routes have been added to this event yet.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var route in Model.Routes)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">

                                <h5 class="card-title">@route.RouteName</h5>

                                <p class="text-muted">
                                    @route.DistanceKm km
                                </p>

                                <p>
                                    <strong>Areas covered:</strong>
                                    @route.AreasCovered
                                </p>

                                <p>
                                    <strong>Start:</strong>
                                    @route.StartLocation
                                </p>

                                <p>
                                    <strong>Finish:</strong>
                                    @route.FinishLocation
                                </p>

                                @if (!string.IsNullOrWhiteSpace(route.Description))
                                {
                                    <p>@route.Description</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(route.MapUrl))
                                {
                                    <a href="@route.MapUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-primary">
                                        View Route Map
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Categories section -->
    <section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Event Categories</h2>

        <a asp-controller="Organiser"
           asp-action="CreateCategory"
           asp-route-eventId="@Model.EventId"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Category
        </a>
    </div>

        @if (Model.Categories.Count == 0)
        {
            <div class="alert alert-info">
                No categories have been added to this event yet.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var category in Model.Categories)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">

                                <h5 class="card-title">@category.Name</h5>

                                <span class="badge bg-primary">
                                    @category.CategoryType
                                </span>

                                <p class="mt-3">
                                    <strong>Associated route:</strong>
                                    @(Model.Routes.FirstOrDefault(route =>
                                        route.RouteId == category.RouteId)?.RouteName ?? "Route unavailable")
                                </p>

                                @if (category.CategoryType == "Age")
                                {
                                    <p>
                                        <strong>Age range:</strong>
                                        @(category.MinimumAge?.ToString() ?? "No minimum")
                                        –
                                        @(category.MaximumAge?.ToString() ?? "No maximum")
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted">
                                        This category is based on route distance.
                                    </p>
                                }

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Return to the organiser dashboard -->
    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>