@model RaceDay_MVC_Part3.Models.CreateRouteViewModel

@{
    ViewData["Title"] = "Add Route";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Add Event Route</h1>
        <p class="text-muted">
            Enter the details of the route you want to add to this event.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="CreateRoute" method="post">

                @* Preserve the event ID when the form is submitted. *@
                <input type="hidden" asp-for="EventId" />

                @* Display validation and API errors. *@
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RouteName" class="form-label">
                        Route Name
                    </label>
                    <input asp-for="RouteName" class="form-control"
                           placeholder="e.g. Community 5K Route" />
                    <span asp-validation-for="RouteName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AreasCovered" class="form-label">
                        Areas Covered
                    </label>
                    <input asp-for="AreasCovered" class="form-control"
                           placeholder="e.g. Central Johannesburg" />
                    <span asp-validation-for="AreasCovered"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DistanceKm" class="form-label">
                        Distance (km)
                    </label>
                    <input asp-for="DistanceKm" class="form-control"
                           type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="DistanceKm"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartLocation" class="form-label">
                        Start Location
                    </label>
                    <input asp-for="StartLocation" class="form-control" />
                    <span asp-validation-for="StartLocation"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FinishLocation" class="form-label">
                        Finish Location
                    </label>
                    <input asp-for="FinishLocation" class="form-control" />
                    <span asp-validation-for="FinishLocation"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description (optional)
                    </label>
                    <textarea asp-for="Description" class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MapUrl" class="form-label">
                        Route Map URL (optional)
                    </label>
                    <input asp-for="MapUrl" class="form-control"
                           placeholder="https://..." />
                    <span asp-validation-for="MapUrl"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Add Route
                    </button>

                    <a asp-action="ManageEvent"
                       asp-route-id="@Model.EventId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}