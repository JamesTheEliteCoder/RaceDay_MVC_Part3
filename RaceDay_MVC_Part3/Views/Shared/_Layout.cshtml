<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay_MVC_Part3.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar shadow-sm mb-4">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold fs-3" asp-controller="Home" asp-action="Index">
                    <span class="brand-race">RACE</span><span class="brand-day">DAY</span>
                    <span class="brand-tagline">RUN YOUR RACE</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="raceDayNavbar">

                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetInt32("UserId") is not null)
                        {
                            var role = Context.Session.GetString("Role");

                            if (role == "Organiser")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Organiser"
                                       asp-action="Dashboard">
                                        Dashboard
                                    </a>
                                </li>
                            }
                            else if (role == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Participant"
                                       asp-action="Index">
                                        My RaceDay
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Profile"
                                       asp-action="Index">
                                        My Profile
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (Context.Session.GetInt32("UserId") is not null)
                        {
                            <li class="nav-item me-lg-3">
                                <span class="navbar-text">
                                    Hi, @(Context.Session.GetString("FirstName") ?? "Racer")
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-raceday-outline btn-sm">
                                        Sign out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Sign in
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>